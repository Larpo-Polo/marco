
---
const title = "Marco Search";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Search the web with Marco." />
    <title>{title}</title>
  </head>

  <body>
    <main class="home">
  <img src="/marco.png" alt="Marco Search" class="logo-img" />
      <a class="logo" href="/">marco<span>.</span></a>

      <form action="/search" method="GET" class="search-form">
        <label class="sr-only" for="query">Search the web</label>

        <input
          id="query"
          name="q"
          type="search"
          placeholder="What are you looking for?"
          autocomplete="off"
          required
        />

        <button type="submit"><img src="/search.svg" alt="Search" height="20px" /></button>
      </form>
      <p class="hint">Simple. Fast. Focused.</p> 
    </main>
     <div class="footer">
        <a class="footer-link" href="">About Us</a> | 
        <a class="footer-link" href="">Contact</a> 
      </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #fffffa;
    font-family: system-ui, sans-serif;
  }

  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap:0;
  }

  .logo {
    color: #612118;
    text-decoration: none;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 750;
	  margin-top:-20px;
    letter-spacing: -0.09em;
  }

  .logo span {
    color: #eabb5f;
  }

  .search-form {
    display: flex;
    gap: 10px;
    width: min(100%, 700px);
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    padding: 16px 20px;
    border: 1px solid #30354163;
    border-top-left-radius: 40px;
    border-bottom-left-radius: 40px;
    background: #eabc5f45;
    color: rgb(11, 11, 11);
    font: inherit;
    outline: none;
  }

  .search-form input:focus {
    border-color: #f9a51e;
  }

  .search-form button {
    padding: 0 22px;
    border: 1px solid #30354163;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    background: #eabb5f;
    color: #ffffff;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    margin-left:-10px;
  }

  .search-form button:hover {
    background: #f4c870;
	  transition: background 0.3s ease;
  }

  .hint {
    margin-top: 24px;
    color: #777d8b;
    font-size: 0.85rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px; 
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .logo-img {
	width: 150px;
	height: auto;
	border-radius: 50%;
  }
  .footer{
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    padding: 16px;
    text-align: center;
    color: #777d8b;
    font-size: 0.85rem;
    gap:10px;
  }

  .footer-link {
    color: #777d8b;
    text-decoration: none;
  }
  
  .footer-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .search-form {
      flex-direction: column;
    }

    .search-form button {
      min-height: 48px;
    }
  }
</style>
